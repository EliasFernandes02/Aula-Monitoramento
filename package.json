{
  "name": "aula-api-pagamentos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API didatica de autenticacao e pagamentos com Express e PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node --import ./src/instrument.js src/server.js",
    "dev": "node --watch --import ./src/instrument.js src/server.js",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "load:payments": "node scripts/load-test-payments.js",
    "sentry:test-error": "node scripts/sentry-error-demo.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "@sentry/node": "^11.17.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  }
}
